<div style="text-align: center; padding: 4rem;">
  <h1>Bienvenido a Fuyén</h1>
  <p>Salmón ahumado artesanal.</p>
  <p><em>Catálogo próximamente...</em></p>
  <% if user_signed_in? %>
    <p>Sesión iniciada como <%= current_user.nombre_completo %>.</p>
  <% else %>
    <%= link_to "Iniciar sesión", new_user_session_path %> |
    <%= link_to "Registrarse", new_user_registration_path %>
  <% end %>
</div>
