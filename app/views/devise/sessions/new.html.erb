<div class="auth-card">
  <h1>Iniciar sesión</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="form-group" data-controller="password-toggle">
      <%= f.label :password, "Contraseña" %>
      <div class="password-field">
        <%= f.password_field :password, autocomplete: "current-password", data: { "password-toggle-target": "input" } %>
        <button type="button" class="password-toggle-btn" data-action="password-toggle#toggle" aria-label="Mostrar u ocultar contraseña">
          <svg data-password-toggle-target="eyeOpen" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display: none;">
            <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7-10.5-7-10.5-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/>
          </svg>
          <svg data-password-toggle-target="eyeSlash" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display: block;">
            <path d="M3 3l18 18M9.9 5.2A10.6 10.6 0 0 1 12 5c6.5 0 10.5 7 10.5 7a13.9 13.9 0 0 1-3.15 3.9M6.5 6.6C3.4 8.6 1.5 12 1.5 12s4 7 10.5 7a9.9 9.9 0 0 0 4.3-.95M14.1 14.1a3 3 0 0 1-4.2-4.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <%= f.submit "Iniciar sesión", class: "btn btn-primary auth-submit" %>
  <% end %>

  <p class="auth-alt">
    <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name) %>
  </p>
  <p class="auth-alt">
    ¿Todavía no tienes cuenta? <%= link_to "Regístrate aquí", new_registration_path(resource_name) %>
  </p>
</div>
