<div class="auth-card">
  <h1>Recupera tu contraseña</h1>
  <p class="auth-alt">Escribe tu email y te enviamos un link para elegir una nueva contraseña.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <%= f.submit "Enviar instrucciones", class: "btn btn-primary auth-submit" %>
  <% end %>

  <p class="auth-alt">
    <%= link_to "Volver a iniciar sesión", new_session_path(resource_name) %>
  </p>
</div>
