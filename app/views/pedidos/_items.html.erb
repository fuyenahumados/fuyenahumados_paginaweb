<h2>Productos</h2>
<table>
  <thead>
    <tr>
      <th>Producto</th>
      <th class="text-center">Cantidad</th>
      <th class="text-right">Precio unit.</th>
      <th class="text-right">Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% pedido.order_items.each do |item| %>
      <tr>
        <td><%= item.product.nombre %></td>
        <td class="text-center"><%= item.cantidad %></td>
        <td class="text-right"><%= formato_pesos(item.precio_unitario) %></td>
        <td class="text-right"><%= formato_pesos(item.subtotal) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3">Subtotal productos</td>
      <td class="text-right"><%= formato_pesos(pedido.subtotal_productos) %></td>
    </tr>
    <tr>
      <td colspan="3">Envío</td>
      <td class="text-right">
        <% if pedido.envio.zero? %>
          <span class="envio-gratis">Gratis</span>
        <% else %>
          <%= formato_pesos(pedido.envio) %>
        <% end %>
      </td>
    </tr>
    <tr class="total-row">
      <td colspan="3">Total</td>
      <td class="text-right"><%= formato_pesos(pedido.total) %></td>
    </tr>
  </tfoot>
</table>
