<div class="page-header">
  <h1>Consultar mi pedido</h1>
  <p class="page-header-desc">Ingresa el código de tu pedido (por ejemplo FUY-A1B2C3) para ver su estado.</p>
</div>

<%= form_with url: buscar_pedido_publico_path, method: :post, class: "consulta-pedido-form" do %>
  <%= label_tag :codigo_pedido, "Código de pedido" %>
  <div class="consulta-pedido-buscar-wrap">
    <%= text_field_tag :codigo_pedido, params[:codigo_pedido], placeholder: "FUY-XXXXXX", required: true %>
    <button type="submit" class="consulta-pedido-buscar-btn" aria-label="Buscar">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
<% end %>
