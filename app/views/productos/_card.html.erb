<div class="producto-card">
  <div class="producto-foto-wrap">
    <%= link_to producto_path(product), class: "producto-foto-link", data: { turbo_frame: "_top" } do %>
      <% if product.foto_url.present? %>
        <%= image_tag product.foto_url, alt: product.nombre, class: "producto-foto" %>
      <% else %>
        <div class="producto-foto producto-foto-placeholder"></div>
      <% end %>
    <% end %>
    <%= render "productos/accion_carrito", product: product %>
  </div>
  <%= link_to producto_path(product), class: "producto-nombre", data: { turbo_frame: "_top" } do %>
    <span class="producto-nombre-texto"><%= product.nombre %></span>
    <span class="producto-nombre-peso"><%= "(#{product.peso_descripcion})" if product.peso_descripcion.present? %></span>
  <% end %>
  <p class="producto-precio"><%= formato_pesos(product.precio) %></p>
</div>
