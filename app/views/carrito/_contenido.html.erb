<% if carrito_items.empty? %>
  <div class="carrito-vacio">
    <svg class="carrito-vacio-icono" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="9" cy="21" r="1.4" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="18" cy="21" r="1.4" stroke="currentColor" stroke-width="1.6"/>
      <path d="M1.5 2h2.4l2.2 12.6a1.8 1.8 0 0 0 1.78 1.4h9.3a1.8 1.8 0 0 0 1.77-1.47L21 6.5H5.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <p class="carrito-vacio-texto">Tu carrito está vacío</p>
    <%= link_to "Ver productos", productos_path, class: "btn btn-primary", data: { turbo_frame: "_top" } %>
  </div>
<% else %>
  <div class="carrito-layout">
    <div class="carrito-items">
      <%= render partial: "carrito/item", collection: carrito_items, as: :item %>
    </div>

    <%= render "carrito/resumen" %>
  </div>

  <p class="carrito-nota-peso">
    Los pesos son aproximados y pueden variar según el corte. El precio es fijo por pieza.
  </p>
<% end %>
