<% content_for :fluid, true %>
<% content_for :show_footer, true %>

<section class="hero">
  <div class="hero-inner">
    <h1 class="hero-titulo">Fuyén Ahumados</h1>
    <p class="hero-subtitulo">Salmón ahumado artesanal</p>
    <%= link_to "Explorar productos", productos_path, class: "btn btn-hero" %>
  </div>
</section>

<section class="seccion seccion-clara">
  <div class="seccion-inner">
    <h2 class="seccion-titulo">Nuestros productos</h2>
    <p class="seccion-subtitulo">
      Elaboramos cada producto de forma 100% artesanal, con una receta propia que fuimos
      perfeccionando con harto tiempo, paciencia y cariño. Cuidamos cada detalle del proceso,
      desde la selección del salmón hasta el ahumado final con nuestra mezcla de ulmo y roble,
      para lograr ese sabor que nos recuerda al sur de Chile.
    </p>

    <%
      # Fotos fijas del collage de la Home: son ilustrativas del tipo de
      # producto (salmón ahumado artesanal), no están ligadas a qué productos
      # estén publicados/activos en el catálogo en un momento dado — a
      # propósito, para que esta sección nunca dependa del estado del catálogo.
      collage_grande = "/docs/banners/salmon-recien-salido-home.jpg"
      collage_chicas = %w[/docs/banners/salmon-redimensionado-1.jpeg /docs/banners/salmon-redimensionado-2.jpeg]
    %>
    <div class="productos-collage">
      <div class="collage-grande">
        <%= image_tag collage_grande, alt: "Salmón ahumado Fuyén recién salido del ahumador" %>
      </div>

      <div class="collage-chicas">
        <% collage_chicas.each do |foto| %>
          <div class="collage-chica">
            <%= image_tag foto, alt: "Salmón ahumado Fuyén" %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="seccion-cta">
      <%= link_to "Ver todos los productos", productos_path, class: "btn btn-navy-grande" %>
    </div>
  </div>
</section>

<section class="seccion seccion-clara quienes-somos">
  <div class="quienes-somos-grid">
    <div class="quienes-somos-foto">
      <%= image_tag "/docs/banners/quienes-somos-pablo-gellona.jpeg", alt: "El equipo de Fuyén" %>
    </div>
    <div class="quienes-somos-texto">
      <h2 class="quienes-somos-titulo">Quiénes somos</h2>
      <p class="seccion-texto">
        Somos un emprendimiento de tres amigos que nació del amor por la buena comida,
        la pesca y las juntas de siempre. Empezó como algo casero, ahumando salmón para
        compartir entre nosotros, hasta que nos dimos cuenta de que valía la pena que
        más gente lo probara.
      </p>
      <p class="seccion-texto">
        Hoy seguimos haciéndolo con la misma calma de siempre, afinando la receta con el
        tiempo y sin perder la esencia de cómo partimos. Cada pieza sale con la misma
        dedicación, cuidando cada detalle y las ganas de compartir algo tan bueno como
        lo que nos gusta comer a nosotros.
      </p>
      <%= link_to "Conoce nuestra historia", nosotros_path, class: "btn btn-navy-grande" %>
    </div>
  </div>
</section>

<% mensaje = ERB::Util.url_encode("Hola! Tengo una consulta sobre sus productos.") %>
<a href="https://wa.me/<%= CONTACTO[:whatsapp] %>?text=<%= mensaje %>"
   target="_blank"
   rel="noopener"
   class="whatsapp-flotante"
   title="Escríbenos por WhatsApp">
