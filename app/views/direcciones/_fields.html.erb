<div class="form-group">
  <%= f.label :etiqueta, "Nombre de la dirección (ej: Casa, Oficina)" %>
  <%= f.text_field :etiqueta, placeholder: "Casa" %>
</div>

<div class="form-group">
  <%= f.label :comuna, "Comuna" %>
  <%= f.select :comuna, Direccion::COMUNAS, { include_blank: "Selecciona tu comuna" } %>
</div>

<div class="form-group">
  <%= f.label :calle, "Dirección (calle y número)" %>
  <%= f.text_field :calle %>
</div>

<div class="form-group">
  <%= f.label :numero_depto, "Número de casa o departamento (opcional)" %>
  <%= f.text_field :numero_depto %>
  <small class="field-hint">Solo si tu casa o depto tiene un número aparte del de la calle (ej: "Depto 56", "Casa 12"). Si tu dirección ya es completa tal cual, déjalo en blanco.</small>
</div>
