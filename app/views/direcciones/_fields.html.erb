<div data-controller="direccion-map"
     data-direccion-map-lat-value="<%= f.object.lat %>"
     data-direccion-map-lng-value="<%= f.object.lng %>">
  <div class="form-group">
    <%= f.label :etiqueta, "Nombre de la dirección (ej: Casa, Oficina)" %>
    <%= f.text_field :etiqueta, placeholder: "Casa" %>
  </div>

  <div class="form-group">
    <%= f.label :comuna, "Comuna" %>
    <%= f.select :comuna, Direccion::COMUNAS, { include_blank: "Selecciona tu comuna" },
          data: { "direccion-map-target": "comuna" } %>
  </div>

  <div class="form-group">
    <%= f.label :calle, "Dirección (calle y número)" %>
    <%= f.text_field :calle,
          data: { "direccion-map-target": "calle", action: "input->direccion-map#buscar" } %>
    <small class="field-hint">Escribe tu dirección y el mapa se irá actualizando. Si el pin no queda exacto, arrástralo.</small>
  </div>

  <div data-direccion-map-target="map" class="direccion-mapa"></div>
  <%= f.hidden_field :lat, data: { "direccion-map-target": "lat" } %>
  <%= f.hidden_field :lng, data: { "direccion-map-target": "lng" } %>
</div>
