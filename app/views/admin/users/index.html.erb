<div class="admin-header">
  <h1>Usuarios</h1>
</div>

<% if @usuarios.empty? %>
  <p class="empty-state">No hay clientes registrados aún.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Email</th>
        <th>Teléfono</th>
        <th>Comuna</th>
        <th class="text-center">Pedidos</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @usuarios.each do |usuario| %>
        <tr>
          <td><strong><%= usuario.nombre_completo %></strong></td>
          <td><%= usuario.email %></td>
          <td><%= usuario.telefono %></td>
          <td><%= usuario.direccion_principal&.comuna || "—" %></td>
          <td class="text-center"><%= usuario.orders.size %></td>
          <td class="acciones-fila">
            <%= link_to "Ver Usuario", admin_user_path(usuario) %>
            <%= button_to "Eliminar",
                  admin_user_path(usuario),
                  method: :delete,
                  class: "btn-link-danger",
                  data: { turbo_confirm: "¿Eliminar a #{usuario.nombre_completo}? Esta acción no se puede deshacer." } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
