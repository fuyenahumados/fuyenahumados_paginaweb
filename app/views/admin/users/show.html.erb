<%= link_to "← Todos los usuarios", admin_users_path %>

<div class="admin-header" style="margin-top: 1.5rem;">
  <h1><%= @usuario.nombre_completo %></h1>
  <%= button_to "Eliminar usuario",
        admin_user_path(@usuario),
        method: :delete,
        class: "btn btn-danger",
        data: { turbo_confirm: "¿Eliminar a #{@usuario.nombre_completo}? Esta acción no se puede deshacer." } %>
</div>

<div class="admin-card" style="max-width: 560px; margin-bottom: 2rem;">
  <h2>Datos del cliente</h2>
  <dl>
    <dt>Email</dt>      <dd><%= @usuario.email %></dd>
    <dt>Teléfono</dt>   <dd><%= @usuario.telefono %></dd>
    <dt>Cliente desde</dt> <dd><%= @usuario.created_at.strftime("%d/%m/%Y") %></dd>
  </dl>
</div>

<h2>Direcciones</h2>
<% @usuario.direcciones.each do |direccion| %>
  <div class="direccion-card">
    <div>
      <div class="direccion-card-etiqueta">
        <%= direccion.etiqueta %>
        <% if direccion.principal? %>
          <span class="badge-principal">(Principal)</span>
        <% end %>
      </div>
      <div class="direccion-card-detalle"><%= direccion.calle %>, <%= direccion.comuna %></div>
    </div>
  </div>
<% end %>

<h2>Pedidos</h2>

<% if @pedidos.empty? %>
  <p class="empty-state">Este cliente todavía no ha hecho pedidos.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Código</th>
        <th>Fecha</th>
        <th>Estado</th>
        <th class="text-right">Total</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @pedidos.each do |pedido| %>
        <tr>
          <td><%= pedido.codigo_pedido %></td>
          <td><%= pedido.created_at.strftime("%d/%m/%Y") %></td>
          <td><%= estado_badge(pedido.estado) %></td>
          <td class="text-right"><%= formato_pesos(pedido.total) %></td>
          <td><%= link_to "Ver Pedido", admin_pedido_path(pedido) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
