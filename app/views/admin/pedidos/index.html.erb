<div class="admin-header">
  <h1>Pedidos</h1>
</div>

<div class="acciones">
  <%= link_to "Nuevo pedido manual", new_admin_pedido_path, class: "btn btn-primary" %>
</div>

<%= form_with url: admin_pedidos_path, method: :get, class: "admin-buscador" do %>
  <div class="admin-buscador-wrap">
    <%= text_field_tag :buscar, @buscar, placeholder: "Buscar por código, cliente o email..." %>
    <button type="submit" class="admin-buscador-btn" aria-label="Buscar">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <% if @buscar.present? %>
    <%= link_to "Ver todos", admin_pedidos_path, class: "carrito-resumen-seguir" %>
  <% end %>
<% end %>

<div class="admin-herramientas">
  <%= form_with url: admin_pedidos_path, method: :get, class: "admin-herramienta" do %>
    <label for="fecha">Filtrar por fecha de entrega</label>
    <div class="admin-herramienta-controles">
      <%= render "shared/selector_viernes",
            name: "fecha",
            id: "fecha",
            value: @fecha_filtro&.iso8601,
            min: nil %>
      <%= submit_tag "Filtrar", class: "btn btn-primary" %>
    </div>
    <% if @fecha_filtro.present? %>
      <%= link_to "Ver todos", admin_pedidos_path, class: "carrito-resumen-seguir" %>
    <% end %>
  <% end %>

  <%= form_with url: exportar_admin_pedidos_path, method: :get, data: { turbo: false }, class: "admin-herramienta" do %>
    <label for="fecha_despacho">Descargar Excel de despacho</label>
    <div class="admin-herramienta-controles">
      <%= render "shared/selector_viernes",
            name: "fecha_despacho",
            id: "fecha_despacho",
            value: @proximo_despacho.iso8601,
            min: nil %>
      <%= submit_tag "Descargar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<% if @pedidos.empty? %>
  <p class="empty-state">
    <% if @buscar.present? %>
      No hay pedidos que coincidan con la búsqueda.
    <% elsif @fecha_filtro.present? %>
      No hay pedidos con esa fecha de entrega.
    <% else %>
      No hay pedidos aún.
    <% end %>
  </p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Código</th>
        <th>Cliente</th>
        <th>Fecha</th>
        <th>Entrega</th>
        <th>Items</th>
        <th>Total</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @pedidos.each do |pedido| %>
        <tr>
          <td>
            <%= pedido.codigo_pedido %>
            <% if pedido.manual? %><span class="badge badge-manual">Manual</span><% end %>
          </td>
          <td>
            <% if pedido.user.present? %>
              <%= link_to pedido.user.nombre_completo, admin_user_path(pedido.user) %>
            <% else %>
              <%= pedido.nombre_completo_contacto %> <span class="texto-muted">(invitado)</span>
            <% end %>
          </td>
          <td><%= pedido.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td><%= pedido.fecha_entrega.strftime("%d/%m/%Y") %></td>
          <td class="text-center"><%= pedido.order_items.size %></td>
          <td><%= formato_pesos(pedido.total) %></td>
          <td><%= estado_badge(pedido.estado) %></td>
          <td><%= link_to "Ver Pedido", admin_pedido_path(pedido) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
