<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Admin — Fuyén</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <nav class="admin-nav" data-controller="nav-menu">
      <div class="nav-left">
        <a href="<%= admin_root_path %>" class="logo">
          <%= image_tag "/docs/logo/logo-blanco.png", alt: "", class: "logo-imagen" %>
          Fuyén Ahumados <span class="admin-tag">Admin</span>
        </a>
      </div>
      <div class="nav-panel" data-nav-menu-target="panel">
        <div class="nav-center">
          <%= link_to "Pedidos", admin_pedidos_path, class: ("active" if controller_path == "admin/pedidos") %>
          <%= link_to "Productos", admin_products_path, class: ("active" if controller_path == "admin/products") %>
          <%= link_to "Usuarios", admin_users_path, class: ("active" if controller_path == "admin/users") %>
        </div>
        <div class="nav-right">
          <a href="<%= root_path %>" target="_blank">Página web</a>
          <%= button_to "Salir", destroy_user_session_path, method: :delete, class: "nav-salir" %>
        </div>
      </div>
      <button type="button"
              class="nav-hamburguesa"
              data-nav-menu-target="boton"
              data-action="click->nav-menu#toggle"
              aria-label="Abrir menú"
              aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </nav>

    <% if notice.present? %>
      <div class="flash notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash alert"><%= alert %></div>
    <% end %>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
