<%= link_to "← Volver a mi perfil", perfil_path %>

<h1 style="margin-top: 1.5rem;">Editar mis datos</h1>

<%= form_with model: current_user, url: perfil_path, method: :patch, class: "form-admin" do |f| %>
  <% if current_user.errors.any? %>
    <div class="flash alert">
      <% current_user.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div class="form-row">
    <div class="form-group">
      <%= f.label :nombre, "Nombre" %>
      <%= f.text_field :nombre, required: true %>
    </div>
    <div class="form-group">
      <%= f.label :apellido, "Apellido" %>
      <%= f.text_field :apellido, required: true %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :telefono, "Teléfono" %>
    <%= f.text_field :telefono %>
  </div>

  <div class="acciones">
    <%= f.submit "Guardar cambios", class: "btn btn-primary" %>
    <%= link_to "Cancelar", perfil_path, class: "btn btn-secondary" %>
  </div>
<% end %>
